# Marvelous Docs API - environment reference
#
# The running server reads these variables from the process environment. For a
# full stack deployment use the repository-root .env.example instead; this file
# documents the API contract and can be used when the API runs on its own.
#
# Local development: "pnpm dev:server" loads the repository-root .env via
# "node --env-file=../../.env". Put the values below in ./.env only when you run
# the API without the root file.

# <REQUIRED> PostgreSQL connection string.
DATABASE_URL=postgres://marvelous:change-me@localhost:5432/marvelous

# <REQUIRED in production> JWT signing secret, 32+ random bytes.
# "openssl rand -hex 32". Development falls back to an insecure placeholder.
JWT_SECRET=replace-with-a-long-random-secret

# Optional. HTTP port and bind address (defaults 3000 / 0.0.0.0).
PORT=3000
HOST=0.0.0.0
# Optional. Port for the y-websocket collaboration endpoint (default 1234).
COLLAB_PORT=1234
# Optional. Directory for uploaded files (default /data/uploads).
UPLOAD_DIR=/data/uploads
# Optional. Comma-separated allowed browser origins; unset allows every origin.
CORS_ORIGIN=https://docs.example.com

# <REQUIRED on first start> Bootstrap workspace administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# Optional. Display name of the bootstrap account.
BOOTSTRAP_ADMIN_NAME=Administrator

# Optional. Version reported by GET /api/v1/system/version (default 0.1.24).
APP_VERSION=0.1.24
# Optional. Release manifest URL used by the update checker.
UPDATE_MANIFEST_URL=
# Optional. Update agent endpoint plus its shared secret; leave unset to disable
# the in-app updater.
UPDATE_AGENT_URL=http://updater:8080
UPDATE_AGENT_TOKEN=
