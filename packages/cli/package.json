{
  "name": "@marvelous-docs/cli",
  "version": "0.1.61",
  "private": false,
  "description": "Command line client for Marvelous Docs: documents, comments, versions, sharing, and uploads over the versioned REST API.",
  "type": "module",
  "bin": {
    "mdocs": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
