# Marvelous Docs - deployment environment template
#
# Copy to .env (git ignores it) and fill in every value marked <REQUIRED>.
# docker compose reads this file automatically; apps/server/.env.example lists
# the same variables from the API process point of view.
#
# Generate secrets with OpenSSL (hex output needs no URL escaping):
#   openssl rand -hex 32   # JWT_SECRET, UPDATE_AGENT_TOKEN
#   openssl rand -hex 24   # POSTGRES_PASSWORD
# On Windows: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# --- Public entry point -------------------------------------------------------
# <REQUIRED> Host name Caddy serves and requests a certificate for. Use
# "localhost" for a local instance (Caddy then uses its local CA).
DOCS_DOMAIN=localhost

# --- Images and version -------------------------------------------------------
# Optional. Set these to released tags to "docker compose pull" instead of
# building from this checkout.
API_IMAGE=marvelous-docs-api:local
WEB_IMAGE=marvelous-docs-web:local
# Optional. Version reported by GET /api/v1/system/version and compared with the
# update manifest; keep it equal to the image tag when running a release.
APP_VERSION=0.1.40

# --- Updates (optional feature) -----------------------------------------------
# Optional. HTTPS URL of a release manifest (latest.json), for example
# https://github.com/OWNER/marvelous-docs/releases/latest/download/latest.json
# Leave empty to disable update checks; the in-app update button stays disabled.
UPDATE_MANIFEST_URL=
# <REQUIRED by docker compose> Shared secret between the API and the updater
# service. Generate with "openssl rand -hex 32"; never commit or reuse it.
UPDATE_AGENT_TOKEN=

# --- PostgreSQL ---------------------------------------------------------------
# <REQUIRED> Database and role created on the first start of the volume.
POSTGRES_DB=marvelous_docs
POSTGRES_USER=marvelous_docs
# <REQUIRED> Password for POSTGRES_USER, e.g. "openssl rand -hex 24".
POSTGRES_PASSWORD=
# Optional for compose (the api service derives its connection string), set it
# for host-side tooling such as "pnpm dev:server":
#   postgresql://marvelous_docs:PASSWORD@localhost:5432/marvelous_docs
DATABASE_URL=

# --- API application ----------------------------------------------------------
# <REQUIRED> JWT signing secret, at least 32 random bytes. Rotating it signs
# every session out.
JWT_SECRET=
# <REQUIRED on first start> First workspace administrator. The account is only
# created when the e-mail does not exist yet; later changes happen in the app.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# <REQUIRED on first start> Password for that account (12+ characters).
BOOTSTRAP_ADMIN_PASSWORD=
# Optional. Display name of the bootstrap account.
BOOTSTRAP_ADMIN_NAME=Administrator
# Optional. Comma-separated browser origins allowed to call the API. Leave empty
# when the bundled web client is served from the same origin (recommended).
CORS_ORIGIN=
# Optional. Port the API container listens on for y-websocket. Change it together
# with apps/web/nginx.conf if you remap it.
COLLAB_PORT=1234
# Optional. Directory holding uploaded files; a Docker volume in compose.
UPLOAD_DIR=/data/uploads

# --- Web client ---------------------------------------------------------------
# Optional. Absolute y-websocket base URL baked into the web bundle for browsers
# that cannot use the same-origin /collab proxy, e.g. wss://docs.example.com/collab
VITE_COLLAB_URL=
