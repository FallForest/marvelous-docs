DOCS_DOMAIN=localhost
API_IMAGE=marvelous-docs-api:local
WEB_IMAGE=marvelous-docs-web:local
APP_VERSION=0.1.0
# Stable GitHub Releases URL: https://github.com/OWNER/marvelous-docs/releases/latest/download/latest.json
UPDATE_MANIFEST_URL=
UPDATE_AGENT_TOKEN=replace-with-a-long-random-token
POSTGRES_DB=marvelous_docs
POSTGRES_USER=marvelous_docs
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://marvelous_docs:replace-with-a-long-random-password@localhost:5432/marvelous_docs
JWT_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
