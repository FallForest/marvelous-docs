# Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# Build output
dist/
**/dist/

# TypeScript incremental build metadata
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example
# Written by the update agent at runtime: the tags update.sh should apply. It is
# generated on the deploy host, never committed.
.update-target.env

# Local scratch space, backups, coverage
.tmp/
tmp/
backups/
coverage/
*.log
*.tmp.mjs

# Local tool state
.claude/settings.local.json

# Browser verification artefacts (scripts/verify/*.mjs write these to the repo root)
.tmp-export.pdf
.tmp-export-canvas.png
.tmp-pdf/

# Vite debug output
apps/web/vite-out.txt

# Ad-hoc debugging scripts. Root-anchored on purpose: an unanchored pattern also
# matched the committed scripts/verify/*.mjs helpers.
/probe*.mjs
/app-stub*.js
/shot*.mjs
/.shot-*
/m-probe*.mjs
/m-shot*.mjs
/regex-check*.mjs
/scaffold*.mjs
