# Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# Build output
dist/
**/dist/

# TypeScript incremental build metadata
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example
# Written by the update agent at runtime: the tags update.sh should apply. It is
# generated on the deploy host, never committed.
.update-target.env

# Local scratch space, backups, coverage
.tmp/
tmp/
backups/
coverage/
*.log
*.tmp.mjs

# Local tool state
.claude/settings.local.json

# Browser verification artefacts (scripts/verify/*.mjs write these to the repo root)
.tmp-export.pdf
.tmp-export-canvas.png
.tmp-pdf/
# Measurement output from scripts/verify/measure-*.mjs. Numbers belong in
# docs/PERFORMANCE.md; the raw table is scratch and must not be committed.
/measure-run*.txt

# Raw per-frame motion trace from verify-handdrawn-controls.mjs --motion. Every
# run samples requestAnimationFrame, so the file differs each time and is 2.5 MB;
# it is scratch, and the readable record is the screenshot set plus MOTION.md.
docs/design/handdrawn-v1/implementation-v*/motion-verification.json

# Vite debug output
apps/web/vite-out.txt

# Ad-hoc debugging scripts. Root-anchored on purpose: an unanchored pattern also
# matched the committed scripts/verify/*.mjs helpers.
/probe*.mjs
/app-stub*.js
/shot*.mjs
/.shot-*
/m-probe*.mjs
/m-shot*.mjs
/regex-check*.mjs
/scaffold*.mjs
